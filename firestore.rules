rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRole(role) {
      return isAuthenticated() && role in request.auth.token.get('roles', []);
    }

    function isAdmin() {
      return hasRole('admin') || hasRole('super_admin') || hasRole('operations_admin');
    }

    function isSupportAdmin() {
      return isAdmin() || hasRole('support_admin');
    }

    function isVendor(vendorId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/vendors/$(vendorId))
        && get(/databases/$(database)/documents/vendors/$(vendorId)).data.userId == request.auth.uid;
    }

    function isDriver(driverId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/drivers/$(driverId))
        && get(/databases/$(database)/documents/drivers/$(driverId)).data.userId == request.auth.uid;
    }

    function isValidTimestamp(ts) {
      return ts == request.time;
    }

    // ===== PUBLIC COLLECTIONS =====
    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{id} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /promotions/{id} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    match /platformSettings/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== PRODUCTS (public catalog with restrictions) =====
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin() 
        || isVendor(resource.data.vendorId);
      allow create: if isAuthenticated() && hasRole('vendor')
        && request.resource.data.vendorId == request.auth.uid;
      allow update: if isVendor(resource.data.vendorId)
        && !('commissionRate' in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
      allow delete: if isAdmin();
    }

    match /productVariants/{variantId} {
      allow read: if isAuthenticated() || 
        get(/databases/$(database)/documents/products/$(resource.data.productId)).data.status == 'published';
      allow write: if isAdmin() || isVendor(resource.data.vendorId);
    }

    // ===== INVENTORY =====
    match /inventory/{inventoryId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // Only functions can write inventory (via admin SDK)
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if isCurrentUser(userId) || isAdmin();
      allow create: if isCurrentUser(userId);
      allow update: if isCurrentUser(userId)
        && !('roles' in request.resource.data.diff(resource.data).affectedKeys())
        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
    }

    // ===== ADDRESSES =====
    match /addresses/{addressId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid
        || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ===== CARTS =====
    match /carts/{cartId} {
      allow read, write: if isCurrentUser(cartId) || isAdmin();
    }

    // ===== WISHLISTS =====
    match /wishlists/{wishlistId} {
      allow read, write: if isCurrentUser(wishlistId) || isAdmin();
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow read: if isAuthenticated() && resource.data.customerId == request.auth.uid || isAdmin();
      // Orders created only via Cloud Functions
      allow create, update, delete: if isAdmin();
    }

    match /vendorOrders/{vendorOrderId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || isVendor(resource.data.vendorId);
      // Status updates allowed for vendors (limited fields only via functions)
      allow create, update, delete: if isAdmin();
    }

    // ===== PAYMENTS =====
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin(); // Only via admin SDK
    }

    match /paymentEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ===== DELIVERIES =====
    match /deliveries/{deliveryId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid)
        || isDriver(resource.data.driverId);
      allow write: if isAdmin(); // Status changes via functions only
    }

    match /deliveryEvents/{eventId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ===== VENDORS =====
    match /vendors/{vendorId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || isVendor(vendorId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isVendor(vendorId)
        && !('commissionRate' in request.resource.data.diff(resource.data).affectedKeys())
        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
    }

    match /vendorApplications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== DRIVERS =====
    match /drivers/{driverId} {
      allow read: if isAdmin() || isDriver(driverId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isDriver(driverId)
        && !('status' in request.resource.data.diff(resource.data).affectedKeys())
        && !('totalEarnings' in request.resource.data.diff(resource.data).affectedKeys())
        || isAdmin();
    }

    match /driverApplications/{appId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // ===== FINANCIAL =====
    match /commissions/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    match /settlementLedger/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    match /settlements/{id} {
      allow read: if isAdmin() || isVendor(resource.data.vendorId);
      allow write: if isAdmin();
    }

    // ===== COUPONS =====
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /couponRedemptions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ===== REVIEWS =====
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid
        && request.resource.data.isVerifiedPurchase == true;
      allow update: if isAdmin()
        || (isAuthenticated() && resource.data.customerId == request.auth.uid
          && resource.data.status == 'pending');
    }

    // ===== NOTIFICATIONS =====
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if isAdmin();
    }

    // ===== SUPPORT TICKETS =====
    match /supportTickets/{ticketId} {
      allow read: if isSupportAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isSupportAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid
          && resource.data.status == 'open');
    }

    // ===== AUDIT LOGS =====
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Only via admin SDK in functions
    }

    // ===== SERVICEABILITY ZONES =====
    match /serviceabilityZones/{zoneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ===== DENY ALL ELSE =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
