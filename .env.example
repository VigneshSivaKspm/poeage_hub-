# Firebase Configuration (get from Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App URLs
VITE_USER_APP_URL=http://localhost:5173
VITE_ADMIN_APP_URL=http://localhost:5174
VITE_VENDOR_APP_URL=http://localhost:5175
VITE_DRIVER_APP_URL=http://localhost:5176

# Razorpay (server-side only — NEVER expose secret in browser)
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_secret_here

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_maps_key

# Firebase Functions
FUNCTION_REGION=asia-south1

# Environment
NODE_ENV=development
VITE_USE_EMULATORS=true
