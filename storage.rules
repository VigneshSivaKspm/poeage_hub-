rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        'admin' in request.auth.token.get('roles', []) ||
        'super_admin' in request.auth.token.get('roles', [])
      );
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidDocument() {
      return (request.resource.contentType.matches('image/.*') 
              || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // User avatars - owner writes, public reads
    match /users/{userId}/avatar/{fileName} {
      allow read: if true;
      allow write: if isCurrentUser(userId) && isValidImage();
    }

    // Vendor assets - vendor writes, public reads
    match /vendors/{vendorId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }

    // Product images - authenticated vendor writes, public reads
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidImage();
    }

    // Private verification documents - owner writes, admin reads only
    match /documents/{userId}/{allPaths=**} {
      allow read: if isCurrentUser(userId) || isAdmin();
      allow write: if isCurrentUser(userId) && isValidDocument();
    }

    // Proof of delivery - driver writes, admin reads
    match /proof-of-delivery/{deliveryId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAuthenticated() && isValidImage();
    }

    // Admin uploads (banners, etc.)
    match /admin/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // Deny all else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
